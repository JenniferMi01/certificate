# Django Environment Variables
SECRET_KEY=django-insecure-development-key-for-docker
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/certificate_db

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:80,http://frontend:80,http://localhost:8080

# Static Files
STATIC_URL=/static/
STATIC_ROOT=/app/staticfiles